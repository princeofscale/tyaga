{
  // Isolated local-only agent environment. Never deploy this configuration.
  "name": "tyaga-agent-evolution",
  "main": "server/local.ts",
  "compatibility_date": "2025-09-27",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "tyaga-agent-evolution",
    "database_id": "local-tyaga-agent-evolution",
    "migrations_dir": "drizzle"
  }]
}
