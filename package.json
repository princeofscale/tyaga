{
  "name": "tyaga",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-worker.mjs",
    "build:android": "vite build --mode device && cap sync android",
    "deploy:cloud": "wrangler deploy --config wrangler.production.jsonc",
    "deploy:cloud:check": "wrangler deploy --dry-run --config wrangler.production.jsonc",
    "db:migrate:cloud": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:fast": "tsx --test tests/biomechanics-audit.test.ts tests/smart-coach.test.ts tests/supplements.test.ts tests/anatomy-subheads.test.ts tests/analytics-kernel.test.ts tests/exercise-alternatives.test.ts tests/personal-records.test.ts tests/muscle-readiness.test.ts tests/volume-landmarks.test.ts tests/deload.test.ts tests/laid-auto-maxes.test.ts tests/laid-week-order.test.ts tests/model.test.ts tests/program.test.ts tests/session-report.test.ts tests/shared-programs.test.ts tests/strength-total.test.ts tests/theme.test.ts tests/history-insights.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:visual": "TYAGA_PLAYWRIGHT_MODE=visual playwright test tests/e2e/design.spec.ts tests/e2e/visual-extra.spec.ts",
    "lint": "eslint . --max-warnings=0",
    "check:migrations": "node scripts/check-migrations.mjs",
    "verify:owner-csv": "tsx scripts/verify-owner-csv.ts",
    "db:generate": "drizzle-kit generate",
    "preview:server": "wrangler dev --config wrangler.jsonc --ip 0.0.0.0",
    "catalog:import": "node scripts/import-wger.mjs && node scripts/localize-wger.mjs && tsx scripts/review-wger.ts",
    "catalog:fetch": "node scripts/import-wger.mjs",
    "catalog:localize": "node scripts/localize-wger.mjs",
    "catalog:review": "tsx scripts/review-wger.ts",
    "pretest": "node scripts/build-worker.mjs",
    "test:e2e:prepare": "node scripts/fetch-pose-test-model.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "motion": "^14.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "saxes": "^6.0.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/workers-types": "5.20261007.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.5",
    "esbuild": "^0.25.10",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.73.0",
    "vite": "^6.3.6",
    "wrangler": "4.148.0"
  }
}
