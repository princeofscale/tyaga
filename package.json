{
  "name": "tyaga",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-worker.mjs",
    "build:android": "vite build --mode device && cap sync android",
    "deploy:cloud": "vite build && wrangler d1 migrations apply DB --remote --config wrangler.cloud.jsonc && wrangler deploy --config wrangler.cloud.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "preview:server": "wrangler dev --config wrangler.jsonc --ip 0.0.0.0",
    "catalog:import": "node scripts/import-wger.mjs",
    "catalog:localize": "node scripts/localize-wger.mjs",
    "catalog:review": "tsx scripts/review-wger.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "drizzle-orm": "^0.44.5",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "motion": "^14.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "saxes": "^6.0.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/workers-types": "5.20261007.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "wrangler": "4.148.0"
  }
}
