    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "wrangler": "4.40.0"
