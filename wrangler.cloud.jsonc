// Our own Cloudflare deployment: `npm run deploy:cloud`.
// (wrangler.jsonc is the local development setup.)
{
  "name": "tyaga",
  "main": "server/cloud.ts",
  "compatibility_date": "2025-09-27",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tyaga",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
